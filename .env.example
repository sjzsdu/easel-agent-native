# ── Easel 环境变量 ──────────────────────────────────────
# 复制为 .env 并填入真实值；生产部署通过平台 secret 注入。

# 健康检查
PING_MESSAGE=pong

# ── 认证 ────────────────────────────────────────────────
# 生产必填：32 字节 hex 密钥，用于 Better Auth 会话签名和 secrets 加密。
# 生成方式：openssl rand -hex 32
# 本地 dev 留空会自动生成临时密钥；生产留空会启动失败。
BETTER_AUTH_SECRET=

# 可选：认证回调基址，未设置时自动从请求推断。
# BETTER_AUTH_URL=https://easel.example.com

# 本地开发跳过登录（生产切勿启用）。
# AUTH_DISABLED=true

# ── 数据库 ──────────────────────────────────────────────
# 生产必填：持久化 PostgreSQL 连接串。
# 支持格式：postgresql://user:pass@host:5432/db?sslmode=require
# 本地 dev 留空使用 PGlite 内存库（./data/pglite）。
DATABASE_URL=

# 可选：迁移专用连接（绕过 PgBouncer 事务模式池）。
# DATABASE_URL_UNPOOLED=

# ── 加密密钥 ────────────────────────────────────────────
# 可选：secrets 加密密钥。未设置时回退到 BETTER_AUTH_SECRET。
# 生产建议显式设置以便密钥轮换。
# SECRETS_ENCRYPTION_KEY=

# ── 文件存储 ────────────────────────────────────────────
# 可选：内容产物目录。本地默认 <cwd>/outputs/。
# 生产建议挂载持久卷或对象存储挂载点。
# EASEL_OUTPUTS_DIR=/data/outputs

# ── 发布凭据（经 secrets 注册，此处仅为文档）─────────
# 以下凭据通过框架 secrets 能力注册，在 settings → API keys 中管理。
# 不在此处填值，不在代码或日志中硬编码。
# WECHAT_OA_APP_ID=
# WECHAT_OA_APP_SECRET=
# BILI_SESSDATA=
# BILI_BILI_JCT=
# BILI_DEDEUSERID=
# WEIBO_ACCESS_TOKEN=

# ── 部署平台 ────────────────────────────────────────────
# Nitro preset（node-server / vercel / netlify / cloudflare_pages 等）。
# 留空使用 node-server。
# NITRO_PRESET=node-server

# 生产监听端口（node-server preset）。
PORT=3000

# ── AI 模型（可选，本地 dev 用本地模型）──────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
